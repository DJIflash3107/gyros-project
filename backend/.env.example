# Database Configuration
DATABASE_URL=mysql+pymysql://root:password@localhost:3306/gyros_db?charset=utf8mb4

# JWT Authentication
JWT_SECRET_KEY=change-this-to-a-secure-random-secret-key-at-least-32-chars
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# Application Configuration
APP_NAME=GyrosProject
APP_ENV=development
APP_DEBUG=true
LOG_LEVEL=INFO

# AMD Token Factory Configuration
AMD_API_BASE_URL=https://developer.amd.com.cn/radeon/api/v1
AMD_API_KEY=
AMD_DEFAULT_MODEL=DeepSeek-V4-Flash
AMD_REQUEST_TIMEOUT=600
AMD_STREAM_CHUNK_TIMEOUT=600
AMD_MAX_RETRIES=3
AMD_RPM_LIMIT=18
AMD_RATE_LIMIT_WINDOW_SECONDS=60
AMD_MAX_CONCURRENT_REQUESTS=4

# Agent Configuration
AGENT_MAX_TURNS=10
AGENT_REQUEST_TIMEOUT=120
AGENT_MAX_TOKENS=4096
AGENT_TEMPERATURE=0.3

# Vision Configuration
VISION_MODEL_OVERRIDE=
VISION_MAX_IMAGE_SIZE_MB=5
VISION_EXTRACTION_TEMPERATURE=0.1

# Semantic Mapping Configuration
SEMANTIC_MAPPING_ENABLED=true
SEMANTIC_MAPPING_MODEL=
SEMANTIC_MAPPING_TEMPERATURE=0.0
SEMANTIC_MAPPING_CONFIDENCE_THRESHOLD=0.7

# Storage Configuration
ARTIFACT_STORAGE_BACKEND=local
ARTIFACT_STORAGE_LOCAL_DIR=storage/artifacts
ARTIFACT_MAX_FILE_SIZE_MB=50
ARTIFACT_DOWNLOAD_URL_EXPIRY_SECONDS=3600
ARTIFACT_STORAGE_S3_BUCKET=
ARTIFACT_STORAGE_S3_REGION=us-east-1
ARTIFACT_STORAGE_S3_ENDPOINT=
ARTIFACT_STORAGE_S3_ACCESS_KEY=
ARTIFACT_STORAGE_S3_SECRET_KEY=

# Image Generation Configuration
IMAGE_GEN_ENABLED=true
IMAGE_GEN_PROVIDER=amd
IMAGE_GEN_MODEL=
IMAGE_GEN_FALLBACK_MODEL=
IMAGE_GEN_REQUEST_TIMEOUT=120
IMAGE_GEN_MAX_RETRIES=2
IMAGE_GEN_DEFAULT_SIZE=1024x1024
IMAGE_GEN_DEFAULT_QUALITY=standard


# Temporary upload storage for in-process background jobs
BACKGROUND_JOB_STORAGE_DIR=storage/background-jobs
